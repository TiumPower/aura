<%# Merchant back-office chrome: crisp NEUTRAL palette (high contrast) with the
    workspace's brand colour used only as an accent. Keeps the pro dashboard
    legible across every workspace theme. %>
<% ws = current_workspace %>
<style>
  :root {
    --primary:      <%= ws&.theme_value(:primary)   || "#4B4DED" %>;
    --primary-2:    <%= ws&.theme_value(:primary_2) || "#7C7EF5" %>;
    --on-primary:   <%= ws&.theme_value(:on_primary) || "#FFFFFF" %>;
    --surface:      #EFF2F6;
    --surface-2:    #E4E8EE;
    --ink:          #1B1E26;
    --ink-2:        #5B6472;
    --ink-3:        #8A93A3;
    --line:         #E3E6EC;
    --line-2:       #D3D8E0;
    --radius:       14px;
    <% if ws %>
    --font-display: <%= ws.font_stack(:font_display).html_safe %>;
    --font-body:    <%= ws.font_stack(:font_body).html_safe %>;
    <% end %>
  }
  /* Neutral dashboard surfaces (crisp, high-contrast) … */
  body { background: var(--surface); }
  /* … but the sidebar is a VIBRANT brand gradient — same energy as the customer
     app card — so the brand colour reads clearly (not washed out). */
  .l-side { background: linear-gradient(168deg, var(--primary) 0%, color-mix(in srgb, var(--primary) 55%, #000) 100%); color: rgba(255,255,255,.94); }
  .l-side .brand .sub, .l-side .l-navgrp { color: rgba(255,255,255,.6); }
  .l-side .l-nav-item { color: rgba(255,255,255,.9); }
  .l-side .l-nav-item .en { color: rgba(255,255,255,.55); }
  .l-side .l-nav-item:hover { background: rgba(255,255,255,.12); }
  .l-side .l-nav-item.active { background: rgba(255,255,255,.18); box-shadow: inset 3px 0 0 #fff; }
  .l-side .l-nav-item.active .icn, .l-side .l-nav-item.active .en { color: #fff; }
  .l-ws { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.18); }
  .l-side .foot { border-top-color: rgba(255,255,255,.16); }
  .l-side .foot .av { background: rgba(255,255,255,.16); }
</style>
