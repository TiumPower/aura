<h1>Quên mật khẩu</h1>
<p class="sub">Nhập email — chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
      html: { method: :post, data: { turbo: false } }) do |f| %>
  <div class="field">
    <label class="l-label">Email</label>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "l-field", placeholder: "ban@vidu.com" %>
  </div>
  <%= f.submit "Gửi liên kết đặt lại", class: "l-btn l-btn-primary", style: "width:100%; margin-top:6px;" %>
<% end %>

<p style="text-align:center; margin-top:18px; font-size:13px;">
  <%= link_to "Quay lại đăng nhập", new_session_path(resource_name), style: "color:var(--ink-2);" %>
</p>
