<div style="font-family:Arial,sans-serif; color:#1B2733; max-width:520px;">
  <h2 style="margin:0 0 6px; color:#1F5FA6;">🎉 Có workspace mới đăng ký</h2>
  <p style="color:#5C6B7A; margin:0 0 18px;">Một chủ nhà vừa tự đăng ký dùng thử trên nền tảng.</p>

  <table style="width:100%; border-collapse:collapse; font-size:14px; margin-bottom:18px;">
    <tr><td style="padding:6px 0; color:#5C6B7A;">Tên workspace</td><td style="padding:6px 0; font-weight:700; text-align:right;"><%= @workspace.name %></td></tr>
    <tr><td style="padding:6px 0; color:#5C6B7A;">Subdomain</td><td style="padding:6px 0; text-align:right;"><%= @workspace.subdomain %></td></tr>
    <tr><td style="padding:6px 0; color:#5C6B7A;">Gói</td><td style="padding:6px 0; text-align:right;"><%= @workspace.plan_record&.name %></td></tr>
    <tr><td style="padding:6px 0; color:#5C6B7A;">Chủ nhà</td><td style="padding:6px 0; text-align:right;"><%= @workspace.billing_email %></td></tr>
    <tr><td style="padding:6px 0; color:#5C6B7A;">Trạng thái</td><td style="padding:6px 0; text-align:right;"><%= @workspace.status_label %></td></tr>
    <tr><td style="padding:6px 0; color:#5C6B7A;">Đăng ký lúc</td><td style="padding:6px 0; text-align:right;"><%= @workspace.created_at.strftime("%d/%m/%Y %H:%M") %></td></tr>
  </table>

  <p style="margin:18px 0;">
    <a href="<%= @admin_url %>" style="background:#1F5FA6; color:#fff; text-decoration:none; padding:12px 22px; border-radius:12px; font-weight:700; display:inline-block;">Xem trong Super Admin</a>
  </p>
</div>
