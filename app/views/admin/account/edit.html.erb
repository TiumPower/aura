<% content_for :title, "Tài khoản Super Admin" %>
<% content_for :title_en, "ACCOUNT" %>

<div style="max-width:520px;">
  <%= form_with model: @admin, url: admin_account_path, method: :patch do |f| %>
    <% if @admin.errors.any? %>
      <div class="l-panel" style="margin-bottom:16px; background:#F7E0DA; color:#B4402F; border:none;">
        <%= @admin.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="l-panel" style="margin-bottom:16px;">
      <div class="l-eyebrow">Thông tin đăng nhập</div>
      <label class="l-label" style="margin-top:8px;">Tên hiển thị</label>
      <%= f.text_field :name, class: "l-field", required: true %>
      <label class="l-label" style="margin-top:12px;">Email đăng nhập</label>
      <%= f.email_field :email, class: "l-field", required: true, autocomplete: "username" %>
    </div>

    <div class="l-panel" style="margin-bottom:16px;">
      <div class="l-eyebrow">Đổi mật khẩu</div>
      <p style="color:var(--ink-2); font-size:12.5px; margin:4px 0 8px;">Để trống nếu chỉ đổi tên/email.</p>
      <label class="l-label">Mật khẩu mới</label>
      <%= f.password_field :password, class: "l-field", autocomplete: "new-password", autocapitalize: "none", autocorrect: "off", spellcheck: "false" %>
      <label class="l-label" style="margin-top:12px;">Nhập lại mật khẩu mới</label>
      <%= f.password_field :password_confirmation, class: "l-field", autocomplete: "new-password", autocapitalize: "none", autocorrect: "off", spellcheck: "false" %>
    </div>

    <div class="l-panel" style="margin-bottom:16px;">
      <div class="l-eyebrow">Xác nhận</div>
      <label class="l-label" style="margin-top:8px;">Mật khẩu hiện tại (bắt buộc)</label>
      <%= f.password_field :current_password, class: "l-field", required: true, autocomplete: "current-password", autocapitalize: "none", autocorrect: "off", spellcheck: "false" %>
    </div>

    <%= f.submit "Lưu thay đổi", class: "l-btn l-btn-primary" %>
  <% end %>
</div>
