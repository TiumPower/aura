<% content_for :title, t("customer.notifications.title") %>
<% content_for :tab, "" %>
<%= render "customer/shared/appbar", title: t("customer.notifications.title"), back: member_root_path %>

<div class="l-screen">
  <% if @notifications.empty? %>
    <div class="l-tile" style="text-align:center; padding:40px 20px;">
      <div style="font-size:40px;">🔔</div>
      <p style="font-weight:600; margin-top:8px;"><%= t("customer.notifications.empty") %></p>
      <p style="color:var(--ink-2); font-size:13px;"><%= t("customer.notifications.empty_sub") %></p>
    </div>
  <% else %>
    <% @notifications.each do |n| %>
      <% inner = capture do %>
        <div style="width:42px; height:42px; border-radius:14px; background:var(--surface-2); display:grid; place-items:center; font-size:20px; flex:none;"><%= n.display_icon %></div>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:700;"><%= n.title %></div>
          <div style="font-size:13px; color:var(--ink-2); margin-top:2px;"><%= n.body %></div>
          <div style="font-size:11px; color:var(--ink-3, var(--ink-2)); margin-top:6px;"><%= t("customer.common.ago", time: time_ago_in_words(n.created_at)) %></div>
        </div>
        <% if n.deep_link.present? %><span style="align-self:center; color:var(--ink-2); flex:none;">›</span><% end %>
      <% end %>
      <% base = "display:flex; gap:12px; margin-bottom:10px; #{'border-left:3px solid var(--primary);' unless n.read?}" %>
      <% if n.deep_link.present? %>
        <%= link_to inner, n.deep_link, class: "l-tile", style: "#{base} text-decoration:none; color:inherit;" %>
      <% else %>
        <%= content_tag :div, inner, class: "l-tile", style: base %>
      <% end %>
    <% end %>
  <% end %>
</div>
