<% content_for :title, t("customer.session.verify_title") %>
<div class="l-screen" style="display:flex; flex-direction:column; justify-content:center; min-height:100dvh;">
  <div style="text-align:center; margin-bottom:22px;">
    <div style="font-size:38px;">🌿</div>
    <h1 class="l-display" style="font-size:24px; margin-top:8px;"><%= t("customer.session.verify_title") %></h1>
    <p style="color:var(--ink-2); font-size:14px; margin-top:6px;">
      <% if @emailed %>
        <%= t("customer.session.verify_sent_email") %>
      <% else %>
        <%= t("customer.session.verify_sent", phone: @phone) %>
      <% end %>
    </p>
  </div>

  <% if @dev_code.present? %>
    <div class="l-panel" style="text-align:center; margin-bottom:16px;
                background:#fdf3e8; border-color:#f0dcc0;">
      <div style="font-size:12.5px; color:var(--ink-2);"><%= t("customer.session.dev_code", code: "") %></div>
      <div class="l-mono" style="font-size:28px; font-weight:700; letter-spacing:.2em;"><%= @dev_code %></div>
      <% if Rails.env.production? %>
        <div style="font-size:11.5px; color:#B4402F; font-weight:600; margin-top:8px; line-height:1.5;">
          <%# Hai lý do khác nhau, và nói đúng lý do thì người vận hành mới biết
              phải làm gì: bật cờ thử nghiệm, hay chưa nối cổng gửi. %>
          <% if @challenge&.deliverable? %>
            ⚠️ Chế độ thử nghiệm đang BẬT nên mã hiện trực tiếp. Phải tắt ở
            /admin/settings trước khi có khách thật.
          <% else %>
            ⚠️ Chưa nối được cổng gửi mã (Zalo/email) nên mã đang hiện trực tiếp.
            Chỉ dùng được để demo — phải nối cổng trước khi có khách thật.
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "customer/sessions/delivery_state", challenge: @challenge %>

  <%= form_with url: member_verify_submit_path, method: :post do %>
    <label class="l-label"><%= t("customer.session.code_label") %></label>
    <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus
           class="l-field l-mono" style="font-size:26px; text-align:center; letter-spacing:.3em; margin-bottom:16px;">
    <%= submit_tag t("customer.session.verify_submit"), class: "l-btn l-btn-primary l-btn-block" %>
  <% end %>

  <%# Gửi lại là việc đầu tiên ai cũng thử khi mã không tới, nên để ngay đây
      thay vì chỉ có đường "đổi số khác". %>
  <div style="display:flex; gap:14px; justify-content:center; align-items:center; margin-top:18px; font-size:13px;">
    <%= button_to t("customer.session.resend"), member_login_path, params: { phone: @phone },
          style: "background:none; border:none; padding:0; cursor:pointer; font:inherit; " \
                 "font-weight:700; color:var(--primary); text-decoration:underline;" %>
    <%= link_to t("customer.session.change_phone"), member_login_path, style: "color:var(--ink-2);" %>
  </div>
</div>
