<% content_for :tab, "wallet" %>
<% content_for :title, "Lịch sử chi tiêu" %>
<%= render "customer/shared/appbar", title: "Lịch sử chi tiêu", back: member_wallet_path %>

<div class="l-screen" style="padding-top:14px;">
  <div class="l-tile" style="margin-bottom:14px;">
    <div class="l-eyebrow">Tổng đã chi tại spa</div>
    <div class="l-num" style="font-size:26px; margin-top:4px;"><%= vnd(@total) %></div>
    <div style="font-size:12.5px; color:var(--ink-2);"><%= @orders.size %> lần thanh toán gần nhất</div>
  </div>

  <% if @orders.empty? %>
    <div class="l-tile" style="text-align:center; padding:30px;">
      <p style="font-weight:600;">Chưa có lần thanh toán nào</p>
    </div>
  <% else %>
    <% @orders.each do |o| %>
      <div class="l-tile" style="margin-bottom:10px;">
        <div style="display:flex; justify-content:space-between; gap:8px;">
          <div>
            <div style="font-weight:700; font-size:14.5px;">
              <%= o.closed_at ? l(o.closed_at, format: "%d/%m/%Y") : "—" %>
            </div>
            <div style="font-size:12.5px; color:var(--ink-2); margin-top:2px;">
              <%= o.branch.name %> ·
              <%= o.order_items.reject { |i| i.kind == "tip" }.map(&:name).join(", ").truncate(56) %>
            </div>
          </div>
          <strong class="l-num" style="font-size:16px; white-space:nowrap;"><%= vnd(o.total) %></strong>
        </div>
        <% if o.points_earned.positive? %>
          <div style="font-size:12px; color:var(--primary-ink); margin-top:6px;">+<%= o.points_earned %> điểm</div>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <div style="height:90px;"></div>
</div>
