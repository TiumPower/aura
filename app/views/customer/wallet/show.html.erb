<% content_for :tab, "wallet" %>
<% content_for :title, "Thẻ của tôi" %>
<%= render "customer/shared/appbar", title: "Thẻ của tôi", back: member_root_path %>
<% m = @member %>

<div class="l-screen" style="padding-top:14px;">
  <%# ---- Ví & điểm ---- %>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px;">
    <div class="l-tile">
      <div class="l-eyebrow">Ví trả trước</div>
      <div class="l-num" style="font-size:24px; margin-top:4px;"><%= vnd(m.wallet_balance) %></div>
    </div>
    <div class="l-tile">
      <div class="l-eyebrow">Điểm thưởng</div>
      <div class="l-num" style="font-size:24px; margin-top:4px;"><%= m.points_balance %></div>
      <% if @point_value.positive? %>
        <div style="font-size:11.5px; color:var(--ink-2);">≈ <%= vnd(m.points_balance * @point_value) %></div>
      <% end %>
    </div>
  </div>

  <% if @tier %>
    <div class="l-tile" style="margin-bottom:14px;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span class="l-pill" style="--_c:<%= @tier.color.presence || '#6B635A' %>;"><%= @tier.name %></span>
        <% if @tier.discount_percent.positive? %>
          <span style="font-size:13px; color:var(--ink-2);">giảm <%= @tier.discount_percent %>% mọi dịch vụ</span>
        <% end %>
      </div>
      <% if @next_tier %>
        <div style="font-size:12.5px; color:var(--ink-2); margin-top:8px;">
          Còn <%= vnd(@next_tier.min_spent - m.total_spent) %> nữa để lên <strong><%= @next_tier.name %></strong>
        </div>
        <div style="height:6px; border-radius:999px; background:var(--surface-2); margin-top:6px; overflow:hidden;">
          <div style="height:100%; width:<%= [(m.total_spent * 100.0 / [@next_tier.min_spent, 1].max).round, 100].min %>%; background:var(--primary);"></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ---- Thẻ liệu trình ---- %>
  <div class="l-section-h"><h3>Thẻ liệu trình</h3></div>
  <% if @cards.empty? %>
    <div class="l-tile" style="text-align:center; padding:28px 18px;">
      <div style="font-size:36px;">🎟️</div>
      <p style="font-weight:600; margin-top:8px;">Bạn chưa có thẻ nào</p>
      <p style="font-size:13px; color:var(--ink-2); margin-top:5px;">
        Mua thẻ nhiều buổi thường rẻ hơn đi lẻ — hỏi quầy lễ tân khi tới spa nhé.
      </p>
    </div>
  <% else %>
    <% @cards.each do |c| %>
      <div class="l-tile" style="margin-bottom:12px; <%= 'opacity:.72;' unless c.usable? %>">
        <div style="display:flex; gap:8px; align-items:center;">
          <div style="flex:1; font-weight:700; font-size:15px;"><%= c.name %></div>
          <span class="l-pill" style="--_c:<%= c.usable? ? '#3F7A57' : '#8A8078' %>;"><%= c.status_label %></span>
        </div>
        <% if c.value_card? %>
          <div class="l-num" style="font-size:22px; margin-top:8px;"><%= vnd(c.value_balance) %></div>
          <div style="font-size:12px; color:var(--ink-2);">số dư còn lại</div>
        <% else %>
          <% c.package_credits.each do |credit| %>
            <div style="margin-top:10px;">
              <div style="display:flex; justify-content:space-between; font-size:13.5px;">
                <span><%= credit.service.name %></span>
                <strong>còn <%= credit.remaining %>/<%= credit.total_sessions %> buổi</strong>
              </div>
              <div style="height:6px; border-radius:999px; background:var(--surface-2); margin-top:5px; overflow:hidden;">
                <div style="height:100%; width:<%= credit.total_sessions.positive? ? (credit.remaining * 100.0 / credit.total_sessions).round : 0 %>%; background:var(--primary);"></div>
              </div>
            </div>
          <% end %>
        <% end %>
        <div style="font-size:12px; color:var(--ink-2); margin-top:10px;">
          Mua <%= l(c.purchased_on, format: "%d/%m/%Y") %>
          <% if c.expires_on %>
            · hạn <%= l(c.expires_on, format: "%d/%m/%Y") %>
            <% if c.days_left && c.days_left >= 0 && c.expiring_soon? %>
              <strong style="color:#B4402F;">(còn <%= c.days_left %> ngày)</strong>
            <% end %>
          <% end %>
        </div>
        <% if c.low_on_sessions? && c.usable? %>
          <div style="background:#fdf3e8; border:1px solid #f0dcc0; border-radius:10px; padding:9px 11px;
                      font-size:12.5px; margin-top:10px;">
            Thẻ còn ít buổi — nhắc quầy khi bạn tới nếu muốn gia hạn.
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# ---- Lịch sử ---- %>
  <% if @wallet_history.any? %>
    <div class="l-section-h" style="margin-top:20px;"><h3>Biến động ví</h3></div>
    <div class="l-tile">
      <% @wallet_history.each do |t| %>
        <div style="display:flex; justify-content:space-between; gap:10px; padding:8px 0; border-top:1px solid var(--line); font-size:13px;">
          <span>
            <%= t.kind_label %>
            <span style="color:var(--ink-2); font-size:11.5px;"><%= l(t.created_at, format: "%H:%M %d/%m") %></span>
          </span>
          <strong style="color:<%= t.amount.negative? ? 'var(--ink)' : '#3F7A57' %>; font-variant-numeric:tabular-nums;">
            <%= t.amount.negative? ? "−" : "+" %><%= vnd(t.amount.abs) %>
          </strong>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @point_history.any? %>
    <div class="l-section-h" style="margin-top:20px;"><h3>Biến động điểm</h3></div>
    <div class="l-tile">
      <% @point_history.each do |t| %>
        <div style="display:flex; justify-content:space-between; gap:10px; padding:8px 0; border-top:1px solid var(--line); font-size:13px;">
          <span>
            <%= t.kind_label %>
            <span style="color:var(--ink-2); font-size:11.5px;"><%= l(t.created_at, format: "%H:%M %d/%m") %></span>
          </span>
          <strong style="color:<%= t.points.negative? ? 'var(--ink)' : '#3F7A57' %>;">
            <%= t.points.negative? ? "" : "+" %><%= t.points %>
          </strong>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= link_to "Lịch sử chi tiêu →", member_spending_path,
        class: "l-btn l-btn-ghost l-btn-block", style: "margin-top:16px;" %>
  <div style="height:90px;"></div>
</div>
