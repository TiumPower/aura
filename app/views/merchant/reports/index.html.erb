<% content_for :title, "Báo cáo" %>

<style>
  .rp-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:14px; }
  .rp-bar { height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden; margin-top:7px; }
  .rp-bar span { display:block; height:100%; background:var(--primary); }
  .rp-rank { display:flex; justify-content:space-between; gap:10px; padding:9px 0; border-top:1px solid var(--line); font-size:13.5px; }
</style>

<div style="display:flex; align-items:center; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
  <% [[7, "7 ngày"], [30, "30 ngày"], [90, "90 ngày"]].each do |days, label| %>
    <%= link_to label, merchant_reports_path(days: days),
          class: "l-chip #{'l-chip-brand' if (params[:days].presence || 30).to_i == days && params[:from].blank?}" %>
  <% end %>
  <%= form_with url: merchant_reports_path, method: :get, style: "display:flex; gap:8px; align-items:center;" do %>
    <%= date_field_tag :from, @from.to_s, class: "l-field", style: "width:auto;" %>
    <%= date_field_tag :to, @to.to_s, class: "l-field", style: "width:auto;" %>
    <%= submit_tag "Xem", class: "l-btn l-btn-ghost" %>
  <% end %>
  <span style="font-size:13px; color:var(--ink-2);">
    <%= l(@from, format: "%d/%m") %> – <%= l(@to, format: "%d/%m/%Y") %><%= " · #{current_branch.name}" if current_branch %>
  </span>
</div>

<%# ---- Tiền ---- %>
<div class="l-eyebrow" style="margin-bottom:8px;">Tiền</div>
<div class="rp-grid" style="margin-bottom:20px;">
  <div class="l-kpi"><div class="k">Doanh thu</div><div class="v" style="font-size:26px;"><%= vnd(@revenue) %></div>
    <div style="font-size:12px; color:var(--ink-2);"><%= @bills %> bill đã đóng</div></div>
  <div class="l-kpi"><div class="k">Bill trung bình (ATV)</div><div class="v" style="font-size:26px;"><%= vnd(@atv) %></div></div>
  <div class="l-kpi"><div class="k">Chi phí + hoa hồng</div><div class="v" style="font-size:26px; color:#B4402F;"><%= vnd(@expenses + @commissions) %></div>
    <div style="font-size:12px; color:var(--ink-2);">chi <%= vnd(@expenses) %> · HH <%= vnd(@commissions) %></div></div>
  <div class="l-kpi" style="border-color:color-mix(in srgb, var(--primary) 35%, var(--line));">
    <div class="k">Lãi thô kỳ này</div>
    <div class="v" style="font-size:26px; color:<%= @profit.negative? ? '#B4402F' : 'var(--primary)' %>;"><%= vnd(@profit) %></div>
    <div style="font-size:12px; color:var(--ink-2);">
      <%= @revenue.positive? ? "biên #{(@profit * 100.0 / @revenue).round}%" : "chưa có doanh thu" %>
    </div>
  </div>
</div>

<%# ---- Hiệu suất ---- %>
<div class="l-eyebrow" style="margin-bottom:8px;">Hiệu suất khai thác</div>
<div class="rp-grid" style="margin-bottom:20px;">
  <div class="l-kpi">
    <div class="k">Tỷ lệ lấp chỗ</div>
    <div class="v" style="font-size:26px;"><%= @utilization %>%</div>
    <div class="rp-bar"><span style="width:<%= [@utilization, 100].min %>%;"></span></div>
    <div style="font-size:12px; color:var(--ink-2); margin-top:6px;">
      <%= @treated_hours %> / <%= @seat_hours %> giờ-chỗ mở bán ·
      <% if @utilization >= 60 %>đang trong vùng tốt (60–75%)
      <% elsif @utilization >= 40 %>còn dư địa bán thêm
      <% else %>thấp — xem lại giá hoặc cách lấp lịch trống<% end %>
    </div>
  </div>
  <div class="l-kpi">
    <div class="k">Doanh thu / giờ trị liệu</div>
    <div class="v" style="font-size:26px;"><%= vnd(@revpath) %></div>
    <div style="font-size:12px; color:var(--ink-2);">
      RevPATH — chỉ tính doanh thu dịch vụ, không gồm tiền bán thẻ
    </div>
  </div>
  <div class="l-kpi">
    <div class="k">Buổi hoàn thành</div>
    <div class="v" style="font-size:26px;"><%= @completed %></div>
    <div style="font-size:12px; color:var(--ink-2);"><%= @treated_hours %> giờ trị liệu</div>
  </div>
  <div class="l-kpi">
    <div class="k">Khách bỏ hẹn</div>
    <div class="v" style="font-size:26px; <%= 'color:#B4402F;' if @no_show_rate > 10 %>"><%= @no_show_rate %>%</div>
    <div style="font-size:12px; color:var(--ink-2);"><%= @no_shows %> bỏ hẹn · <%= @cancelled %> huỷ</div>
  </div>
</div>

<%# ---- Khách ---- %>
<div class="l-eyebrow" style="margin-bottom:8px;">Khách</div>
<div class="rp-grid" style="margin-bottom:20px;">
  <div class="l-kpi"><div class="k">Khách có chi tiêu</div><div class="v" style="font-size:26px;"><%= @guests %></div></div>
  <div class="l-kpi"><div class="k">Tỷ lệ khách quay lại</div><div class="v" style="font-size:26px;"><%= @return_rate %>%</div>
    <div style="font-size:12px; color:var(--ink-2);"><%= @returning %> khách đã đến từ 2 lần</div></div>
  <div class="l-kpi"><div class="k">Hồ sơ khách mới</div><div class="v" style="font-size:26px;"><%= @new_members %></div></div>
  <div class="l-kpi"><div class="k">Đặt lịch qua app/web</div><div class="v" style="font-size:26px;"><%= @online_share %>%</div>
    <div style="font-size:12px; color:var(--ink-2);">phần còn lại do quầy nhận</div></div>
</div>

<%# ---- Cơ cấu & xếp hạng ---- %>
<div style="display:grid; grid-template-columns:1fr 1fr; gap:18px; align-items:start;">
  <div class="l-panel">
    <div class="l-section-h" style="margin:0 0 10px;"><h3>Doanh thu theo nhóm</h3></div>
    <% total = [@by_kind.values.sum, 1].max %>
    <% { "Dịch vụ" => @service_revenue, "Thẻ & nạp ví" => @package_revenue,
         "Hàng bán lẻ" => @retail_revenue, "Tip" => @tips }.each do |label, amount| %>
      <div style="padding:9px 0; border-top:1px solid var(--line);">
        <div style="display:flex; justify-content:space-between; font-size:13.5px;">
          <span><%= label %></span>
          <strong><%= vnd(amount) %></strong>
        </div>
        <div class="rp-bar"><span style="width:<%= (amount * 100.0 / total).round(1) %>%;"></span></div>
      </div>
    <% end %>
    <p style="font-size:12.5px; color:var(--ink-2); margin-top:12px;">
      Bán lẻ đang chiếm <strong><%= @retail_ratio %>%</strong> doanh thu dịch vụ.
      Chuẩn ngành là 15–30% — dưới mức đó là spa đang bỏ tiền trên bàn.
    </p>
  </div>

  <div>
    <div class="l-panel" style="margin-bottom:18px;">
      <div class="l-section-h" style="margin:0 0 6px;"><h3>Dịch vụ bán tốt nhất</h3></div>
      <% if @top_services.empty? %>
        <p style="font-size:13px; color:var(--ink-2);">Chưa có dữ liệu trong kỳ.</p>
      <% else %>
        <% @top_services.each do |name, amount| %>
          <div class="rp-rank"><span><%= name %></span><strong><%= vnd(amount) %></strong></div>
        <% end %>
      <% end %>
    </div>

    <div class="l-panel">
      <div class="l-section-h" style="margin:0 0 6px;">
        <h3>KTV tạo doanh thu cao nhất</h3>
        <%= link_to "Hoa hồng →", merchant_commissions_path %>
      </div>
      <% if @top_staff.empty? %>
        <p style="font-size:13px; color:var(--ink-2);">Chưa có dữ liệu trong kỳ.</p>
      <% else %>
        <% @top_staff.each do |staff_id, amount| %>
          <div class="rp-rank">
            <span><%= @staff_index[staff_id]&.display_name || "—" %></span>
            <strong><%= vnd(amount) %></strong>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
