<% content_for :title, "Sửa nhóm dịch vụ" %>
<%= form_with model: @category, url: merchant_service_category_path(@category), method: :patch do |f| %>
  <div class="l-panel" style="max-width:520px;">
    <div style="margin-bottom:12px;">
      <label class="l-label">Tên nhóm</label>
      <%= f.text_field :name, class: "l-field" %>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px;">
      <div>
        <label class="l-label">Icon</label>
        <%= f.text_field :icon, class: "l-field" %>
      </div>
      <div>
        <label class="l-label">Thứ tự</label>
        <%= f.number_field :position, class: "l-field" %>
      </div>
    </div>
    <div style="display:flex; gap:10px;">
      <%= f.submit "Lưu", class: "l-btn l-btn-primary" %>
      <%= link_to "Huỷ", merchant_service_categories_path, class: "l-btn l-btn-ghost" %>
      <%= button_to "Xoá", merchant_service_category_path(@category), method: :delete, class: "l-btn l-btn-ghost",
            style: "margin-left:auto; color:#B4402F;",
            form: { data: { turbo_confirm: "Xoá nhóm này? Dịch vụ trong nhóm vẫn còn." } } %>
    </div>
  </div>
<% end %>
