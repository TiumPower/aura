<% content_for :title, t("merchant.nav.#{@locked_feature}") %>
<% feature = t("merchant.nav.#{@locked_feature}") %>

<div style="max-width:520px; margin:40px auto;">
  <div class="l-panel" style="padding:40px 28px; text-align:center;">
    <div style="font-size:44px; margin-bottom:10px;">🔒</div>
    <h2 class="l-display" style="font-size:22px; margin-bottom:8px;"><%= t("merchant.locked_feature.title") %></h2>
    <p style="color:var(--ink-2); font-size:14px; margin-bottom:22px; max-width:380px; margin-left:auto; margin-right:auto;">
      <% if @upgrade_plan %>
        <%= t("merchant.locked_feature.body", feature: feature, plan: @upgrade_plan.name) %>
      <% else %>
        <%= t("merchant.locked_feature.body_none", feature: feature) %>
      <% end %>
    </p>
    <%= link_to t("merchant.locked_feature.cta"), merchant_billing_path, class: "l-btn l-btn-primary" %>
  </div>
</div>
