<%= form_with model: room, url: url, method: method do |f| %>
  <% if room.errors.any? %>
    <div class="l-panel" style="background:#fdecec; border-color:#f5c6c6; color:#a11; margin-bottom:16px;">
      <%= room.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div class="l-panel" style="max-width:620px;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin-bottom:14px;">
      <div>
        <label class="l-label">Tên phòng <span style="color:#e5484d;">*</span></label>
        <%= f.text_field :name, class: "l-field", placeholder: "Phòng 1 / Khu foot A" %>
      </div>
      <div>
        <label class="l-label">Mã</label>
        <%= f.text_field :code, class: "l-field", placeholder: "P1" %>
      </div>
      <div>
        <label class="l-label">Loại phòng</label>
        <%= f.select :room_type_id, @room_types.map { |t| [t.name, t.id] }, { include_blank: "Chưa gán" }, class: "l-field" %>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin-bottom:6px;">
      <div>
        <label class="l-label">Số chỗ phục vụ đồng thời</label>
        <%= f.number_field :capacity, class: "l-field", min: 1 %>
        <div style="font-size:12px; color:var(--ink-2); margin-top:4px;">Phòng đơn = 1. Khu 6 ghế = 6.</div>
      </div>
      <div>
        <label class="l-label">Dọn phòng sau mỗi lượt (phút)</label>
        <%= f.number_field :turnaround_minutes, class: "l-field", min: 0,
              placeholder: current_workspace.setting("default_turnaround_minutes") %>
        <div style="font-size:12px; color:var(--ink-2); margin-top:4px;">
          Để trống = theo tham số cơ sở (<%= current_workspace.setting("default_turnaround_minutes") %>′).
        </div>
      </div>
      <div>
        <label class="l-label">Tầng</label>
        <%= f.text_field :floor, class: "l-field" %>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin:14px 0;">
      <div>
        <label class="l-label">Trạng thái</label>
        <%= f.select :status, Room::STATUSES.map { |s| [Room::STATUS_LABELS[s], s] }, {}, class: "l-field" %>
      </div>
      <div>
        <label class="l-label">Thứ tự</label>
        <%= f.number_field :position, class: "l-field" %>
      </div>
    </div>

    <div class="l-toggle-row">
      <div>
        <div style="font-weight:600; font-size:14px;">Cho đặt online</div>
        <div style="font-size:12.5px; color:var(--ink-2);">Tắt để giữ phòng cho khách quen / khách VIP gọi trực tiếp.</div>
      </div>
      <label class="l-switch"><%= f.check_box :online_bookable %><span class="knob"></span></label>
    </div>

    <div style="margin:14px 0;">
      <label class="l-label">Ghi chú nội bộ</label>
      <%= f.text_area :notes, class: "l-field", rows: 2 %>
    </div>

    <div style="display:flex; gap:10px;">
      <%= f.submit room.persisted? ? "Lưu phòng" : "Thêm phòng", class: "l-btn l-btn-primary" %>
      <%= link_to "Huỷ", merchant_branch_path(room.branch || @branch), class: "l-btn l-btn-ghost" %>
      <% if room.persisted? %>
        <%= button_to "Xoá phòng", merchant_room_path(room), method: :delete, class: "l-btn l-btn-ghost",
              style: "margin-left:auto; color:#B4402F;",
              form: { data: { turbo_confirm: "Xoá phòng #{room.name}?" } } %>
      <% end %>
    </div>
  </div>
<% end %>
