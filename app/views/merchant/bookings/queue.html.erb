<% content_for :title, "Hàng chờ tại quầy" %>

<div data-controller="modal">

<div style="display:flex; align-items:center; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
  <strong style="font-size:14.5px;"><%= l(Date.current, format: "%A, %d/%m/%Y") %><%= " · #{@branch.name}" if @branch %></strong>
  <div style="margin-left:auto; display:flex; gap:8px;">
    <%= link_to "Lịch ngày", merchant_calendar_path, class: "l-btn l-btn-ghost" %>
    <%= link_to "⚡ Khách vãng lai", new_merchant_booking_path(walk_in: 1), class: "l-btn l-btn-primary" %>
  </div>
</div>

<% if @late.any? %>
  <div class="l-panel" style="margin-bottom:16px; background:#fdecec; border-color:#f5c6c6;">
    <div style="font-weight:700; font-size:14px; color:#a11;">⏰ <%= @late.size %> khách đã quá giờ hẹn</div>
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
      <% @late.each do |b| %>
        <%= link_to merchant_booking_path(b), class: "l-chip", style: "text-decoration:none;",
              data: { turbo_frame: "booking_peek" } do %>
          <%= b.customer_name %> · trễ <%= b.late_minutes %>′
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:16px; align-items:start;">
  <% [["Sắp tới", @arriving, "⏳"], ["Đang trong tiệm", @in_house, "🟢"], ["Đã xong hôm nay", @done, "✓"]].each do |title, list, icon| %>
    <div class="l-panel">
      <div class="l-section-h" style="margin:0 0 10px;"><h3><%= icon %> <%= title %> (<%= list.size %>)</h3></div>
      <% if list.empty? %>
        <p style="font-size:13px; color:var(--ink-2);">Không có khách nào.</p>
      <% else %>
        <% list.each do |b| %>
          <div style="border-top:1px solid var(--line); padding:11px 0;">
            <div style="display:flex; gap:8px; align-items:center;">
              <strong style="font-size:14px;"><%= b.starts_at.strftime("%H:%M") %></strong>
              <span style="flex:1; font-weight:600; font-size:14px;"><%= b.customer_name %></span>
              <span class="l-pill" style="--_c:<%= b.status_color %>;"><%= b.status_label %></span>
            </div>
            <div style="font-size:12.5px; color:var(--ink-2); margin-top:3px;">
              <%= b.service_summary.truncate(40) %> · <%= b.staff_summary.truncate(24) %>
              <%= " · #{b.rooms_summary}" if b.rooms_summary.present? %>
            </div>
            <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap;">
              <%= link_to "Chi tiết", merchant_booking_path(b), class: "l-chip",
                    data: { turbo_frame: "booking_peek" } %>
              <% if b.can_transition_to?("checked_in") %>
                <%= button_to "Khách đã đến", status_merchant_booking_path(b, value: "checked_in"), method: :patch,
                      class: "l-chip l-chip-brand", form: { style: "display:inline;" } %>
              <% end %>
              <% if b.can_transition_to?("in_progress") %>
                <%= button_to "Bắt đầu", status_merchant_booking_path(b, value: "in_progress"), method: :patch,
                      class: "l-chip l-chip-brand", form: { style: "display:inline;" } %>
              <% end %>
              <% if b.can_transition_to?("completed") %>
                <%= button_to "Xong", status_merchant_booking_path(b, value: "completed"), method: :patch,
                      class: "l-chip l-chip-brand", form: { style: "display:inline;" } %>
              <% end %>
              <% if b.can_transition_to?("no_show") && b.late? %>
                <%= button_to "Không đến", status_merchant_booking_path(b, value: "no_show"), method: :patch,
                      class: "l-chip", form: { style: "display:inline;", data: { turbo_confirm: "Đánh dấu khách không đến? Số lần bỏ hẹn của khách sẽ tăng." } } %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

  <%= render "merchant/shared/booking_peek_dialog" %>
</div>
