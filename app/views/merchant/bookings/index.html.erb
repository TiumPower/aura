<% content_for :title, "Lịch hẹn" %>
<% px = 1.5 %><%# px mỗi phút — 60′ = 90px %>
<% total_min = ((@to - @from) / 60).round %>

<style>
  .cal-wrap { background:#fff; border:1px solid var(--line); border-radius:18px; box-shadow:var(--shadow); overflow:auto; }
  .cal { display:grid; min-width:max-content; }
  .cal-head { display:grid; position:sticky; top:0; z-index:3; background:#fff; border-bottom:1px solid var(--line); }
  .cal-head > div { padding:10px 8px; font-size:12px; font-weight:700; border-left:1px solid var(--line); }
  .cal-head > div:first-child { border-left:none; }
  .cal-head .sub { font-size:11px; font-weight:500; color:var(--ink-2); }
  .cal-body { display:grid; position:relative; }
  .cal-time { border-right:1px solid var(--line); position:relative; background:var(--surface); }
  .cal-time i { position:absolute; left:0; right:0; font-style:normal; font-size:11px; color:var(--ink-2);
    padding-left:8px; border-top:1px solid var(--line); }
  .cal-col { position:relative; border-left:1px solid var(--line); }
  .cal-hr { position:absolute; left:0; right:0; border-top:1px solid var(--line); pointer-events:none; }
  .cal-hr.half { border-top-style:dotted; opacity:.6; }
  .cal-now { position:absolute; left:0; right:0; border-top:2px solid #B4402F; z-index:2; pointer-events:none; }
  .cal-b { position:absolute; left:3px; right:3px; border-radius:10px; padding:5px 7px; overflow:hidden;
    font-size:11.5px; line-height:1.3; color:#fff; text-decoration:none; }
  .cal-b b { display:block; font-size:12px; font-weight:700; }
  .cal-b span { opacity:.9; }
  /* Thời gian dọn phòng: một vạch gạch chéo MỎNG, không phải khối đặc — khối
     đặc bên dưới khối lịch trông đúng như vệt đổ bóng, gây hiểu sai. */
  .cal-buf { position:absolute; left:3px; right:3px; border-radius:0 0 8px 8px; overflow:hidden;
    background:repeating-linear-gradient(45deg, var(--line), var(--line) 3px, transparent 3px, transparent 7px); }
  .cal-lane { position:absolute; inset:0; }
</style>

<div data-controller="modal">

<%# ---- Thanh điều khiển ---- %>
<div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px;">
  <%= link_to "‹", merchant_calendar_path(date: @date - 1), class: "l-chip" %>
  <%= form_with url: merchant_calendar_path, method: :get, style: "display:flex; gap:8px; align-items:center;" do %>
    <%= date_field_tag :date, @date.to_s, class: "l-field", style: "width:auto;", onchange: "this.form.requestSubmit()" %>
  <% end %>
  <%= link_to "›", merchant_calendar_path(date: @date + 1), class: "l-chip" %>
  <%= link_to "Hôm nay", merchant_calendar_path, class: "l-chip l-chip-brand" %>
  <strong style="font-size:14px;"><%= l(@date, format: "%A, %d/%m/%Y") %> · <%= @branch.name %></strong>
  <div style="margin-left:auto; display:flex; gap:8px;">
    <%= link_to "Hàng chờ quầy", queue_merchant_bookings_path, class: "l-btn l-btn-ghost" %>
    <%= link_to "⚡ Khách vãng lai", new_merchant_booking_path(walk_in: 1, date: @date), class: "l-btn l-btn-ghost" %>
    <%= link_to "+ Nhận lịch hẹn", new_merchant_booking_path(date: @date), class: "l-btn l-btn-primary" %>
  </div>
</div>

<%# ---- Chỉ số ngày ---- %>
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; margin-bottom:14px;">
  <div class="l-kpi"><div class="k">Lịch hẹn</div><div class="v" style="font-size:24px;"><%= @stats[:bookings] %></div>
    <div style="font-size:12px; color:var(--ink-2);"><%= @stats[:guests] %> khách</div></div>
  <div class="l-kpi"><div class="k">Giờ đã bán</div><div class="v" style="font-size:24px;"><%= @stats[:sold_hours] %></div>
    <div style="font-size:12px; color:var(--ink-2);">trên <%= @stats[:seat_hours] %> giờ-chỗ</div></div>
  <div class="l-kpi" style="<%= 'border-color:color-mix(in srgb, var(--primary) 40%, var(--line));' if @stats[:utilization] >= 60 %>">
    <div class="k">Tỷ lệ lấp chỗ</div><div class="v" style="font-size:24px;"><%= @stats[:utilization] %>%</div>
    <div style="font-size:12px; color:var(--ink-2);"><%= @stats[:utilization] >= 60 ? "đang tốt" : "còn chỗ để bán" %></div></div>
  <div class="l-kpi"><div class="k">Doanh thu dự kiến</div><div class="v" style="font-size:24px;"><%= vnd(@stats[:revenue]) %></div>
    <div style="font-size:12px; color:var(--ink-2);"><%= vnd(@stats[:revpath]) %>/giờ trị liệu</div></div>
  <% if @stats[:no_shows].positive? || @stats[:cancelled].positive? %>
    <div class="l-kpi"><div class="k">Bỏ hẹn / huỷ</div>
      <div class="v" style="font-size:24px; color:#B4402F;"><%= @stats[:no_shows] %> / <%= @stats[:cancelled] %></div></div>
  <% end %>
</div>

<%# ---- Việc cần xử lý ngay ---- %>
<% if @pending.any? || @unassigned.any? %>
  <div class="l-panel" style="margin-bottom:14px; border-color:color-mix(in srgb, var(--primary-2) 55%, var(--line)); background:color-mix(in srgb, var(--primary-2) 8%, #fff);">
    <% if @pending.any? %>
      <div style="font-weight:700; font-size:14px;">⏳ <%= @pending.size %> lịch đặt online chờ xác nhận</div>
      <div style="display:flex; flex-wrap:wrap; gap:8px; margin:8px 0 12px;">
        <% @pending.each do |b| %>
          <%= link_to merchant_booking_path(b), class: "l-chip", style: "text-decoration:none;",
                data: { turbo_frame: "booking_peek" } do %>
            <%= b.starts_at.strftime("%H:%M") %> · <%= b.customer_name %> · <%= b.service_summary.truncate(28) %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if @unassigned.any? %>
      <div style="font-weight:700; font-size:14px;">👤 <%= @unassigned.size %> lịch chưa gán KTV</div>
      <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
        <% @unassigned.each do |b| %>
          <%= link_to merchant_booking_path(b), class: "l-chip", style: "text-decoration:none;",
                data: { turbo_frame: "booking_peek" } do %>
            <%= b.starts_at.strftime("%H:%M") %> · <%= b.customer_name %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<%# ---- Lịch theo phòng ---- %>
<% if @rooms.empty? %>
  <div class="l-panel" style="text-align:center; padding:40px;">
    <div style="font-size:40px;">🛏️</div>
    <p style="font-weight:700; margin-top:8px;">Cơ sở này chưa có phòng</p>
    <%= link_to "Thêm phòng", merchant_branch_path(@branch), class: "l-btn l-btn-primary", style: "margin-top:12px;" %>
  </div>
<% elsif @windows.empty? %>
  <div class="l-panel" style="text-align:center; padding:40px;">
    <div style="font-size:40px;">🌙</div>
    <p style="font-weight:700; margin-top:8px;">Hôm nay cơ sở nghỉ</p>
    <p style="color:var(--ink-2); font-size:13.5px; margin-top:6px;">
      Quầy vẫn nhận được khách vãng lai nếu mở cửa ngoại lệ.
    </p>
  </div>
<% else %>
  <% cols = "72px repeat(#{@rooms.size}, minmax(150px, 1fr))" %>
  <div class="cal-wrap">
    <div class="cal">
      <div class="cal-head" style="grid-template-columns:<%= cols %>;">
        <div>Giờ</div>
        <% @rooms.each do |r| %>
          <div>
            <%= r.display_name %>
            <div class="sub"><%= r.type_name %> · <%= r.capacity %> chỗ</div>
          </div>
        <% end %>
      </div>

      <div class="cal-body" style="grid-template-columns:<%= cols %>; height:<%= (total_min * px).round %>px;">
        <%# cột giờ %>
        <div class="cal-time">
          <% (0..total_min).step(60) do |m| %>
            <i style="top:<%= (m * px).round %>px;"><%= (@from + m.minutes).strftime("%H:%M") %></i>
          <% end %>
        </div>

        <% @rooms.each do |room| %>
          <div class="cal-col">
            <% (0..total_min).step(30) do |m| %>
              <div class="cal-hr <%= 'half' if (m % 60) != 0 %>" style="top:<%= (m * px).round %>px;"></div>
            <% end %>

            <%# vạch giờ hiện tại %>
            <% if @date == Date.current && Time.current.between?(@from, @to) %>
              <div class="cal-now" style="top:<%= (((Time.current - @from) / 60) * px).round %>px;"></div>
            <% end %>

            <%# các lượt trong phòng này %>
            <% (@by_room[room.id] || []).each do |item| %>
              <% top = (((item.starts_at - @from) / 60) * px) %>
              <% h   = ((item.duration_minutes) * px) %>
              <% b   = item.booking %>
              <%= link_to merchant_booking_path(b), class: "cal-b",
                    style: "top:#{top.round}px; height:#{[h.round, 26].max}px; background:#{b.status_color};",
                    title: "#{b.code} · #{b.customer_name} · #{item.service_label}",
                    data: { turbo_frame: "booking_peek" } do %>
                <b><%= item.starts_at.strftime("%H:%M") %> <%= b.customer_name.truncate(16) %></b>
                <span><%= item.service_label.truncate(26) %></span>
                <% if item.staff_member %>
                  <span style="display:block;">👤 <%= item.staff_member.display_name.truncate(18) %></span>
                <% else %>
                  <span style="display:block; font-weight:700;">⚠ chưa gán KTV</span>
                <% end %>
              <% end %>
              <% if item.buffer_minutes.to_i.positive? %>
                <% bh = [(item.buffer_minutes * px).round, 6].min %>
                <div class="cal-buf" style="top:<%= (top + h).round %>px; height:<%= bh %>px;"
                     title="Dọn phòng <%= item.buffer_minutes %>′ — engine không xếp khách vào đây"></div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <p style="font-size:12.5px; color:var(--ink-2); margin-top:10px;">
    Vạch gạch chéo mỏng dưới mỗi khối là <strong>thời gian dọn phòng</strong> — engine không xếp khách vào đó.
    Bấm vào một khối để mở popup xem nhanh và check-in ngay tại chỗ.
  </p>
<% end %>

  <%= render "merchant/shared/booking_peek_dialog" %>
</div>
