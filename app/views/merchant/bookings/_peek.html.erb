<%# Popup xem nhanh một lịch hẹn, mở từ lịch ngày và hàng chờ quầy.
    Chỉ chứa việc lễ tân làm NGAY khi bấm vào một khối trên lịch: gọi khách,
    đổi trạng thái, mở bill. Những việc cần cân nhắc — đổi giờ, gán lại KTV và
    phòng, ghi chú — ở lại trang đầy đủ, vì chúng cần nhìn cả ngày để quyết.

    Mọi form đặt data-turbo-frame="_top": đổi trạng thái xong thì cả trang lịch
    phải tải lại để khối trên lịch đổi màu, không phải chỉ mỗi popup. %>
<%# `cal_from` là mốc giờ đầu khung lịch đang hiển thị. Có nó thì nút trong
    popup chạy TIẾP TRONG POPUP (server trả Turbo Stream vẽ lại popup + khối
    trên lịch); không có nó — ví dụ mở từ hàng chờ quầy — thì quay về hành vi
    tải lại trang, vẫn đúng. %>
<% in_calendar = cal_from.present? %>
<%= turbo_frame_tag "booking_peek" do %>
  <div style="display:flex; gap:10px; align-items:flex-start;">
    <div style="flex:1; min-width:0;">
      <div style="display:flex; gap:7px; align-items:center; flex-wrap:wrap;">
        <strong style="font-size:18px;"><%= booking.customer_name %></strong>
        <span class="l-pill" style="--_c:<%= booking.status_color %>;"><%= booking.status_label %></span>
      </div>
      <div style="font-size:13px; color:var(--ink-2); margin-top:3px;">
        <%= booking.time_label %> · <%= booking.date_label %> · <%= booking.source_label %>
        <span class="l-mono">· <%= booking.code %></span>
      </div>
    </div>
    <button type="button" class="l-chip" data-action="modal#close" aria-label="Đóng"
            style="cursor:pointer;">✕</button>
  </div>

  <% if booking.late? %>
    <p style="font-size:13px; color:#B4402F; font-weight:700; margin-top:10px;">
      ⏰ Khách đã quá giờ hẹn <%= booking.late_minutes %> phút.
    </p>
  <% end %>

  <% if booking.member&.health_notes.present? %>
    <div style="margin-top:12px; padding:10px 12px; border-radius:10px; background:#fdf3e8; border:1px solid #f0dcc0;">
      <div style="font-weight:700; font-size:13px;">⚠️ Lưu ý sức khoẻ</div>
      <div style="font-size:13px; margin-top:3px; line-height:1.5;"><%= booking.member.health_notes %></div>
    </div>
  <% end %>

  <div style="margin-top:14px; border-top:1px solid var(--line);">
    <% items.each do |item| %>
      <div style="padding:10px 0; border-bottom:1px solid var(--line);">
        <div style="display:flex; gap:8px; align-items:baseline;">
          <strong style="font-size:14px; flex:1;"><%= item.service_label %></strong>
          <span style="font-variant-numeric:tabular-nums; font-weight:700;"><%= vnd(item.total) %></span>
        </div>
        <div style="font-size:12.5px; color:var(--ink-2); margin-top:2px;">
          <%= item.time_label %> ·
          <%= item.room&.display_name || "chưa có phòng" %> ·
          <%= item.staff_member&.display_name || "chưa gán KTV" %>
        </div>
      </div>
    <% end %>
    <div style="display:flex; justify-content:space-between; padding-top:10px; font-size:14px;">
      <span style="color:var(--ink-2);">Tạm tính</span>
      <strong style="font-size:16px;"><%= vnd(booking.estimated_total) %></strong>
    </div>
  </div>

  <% if booking.member && booking.member.preferences.any? %>
    <div style="display:flex; flex-wrap:wrap; gap:5px; margin-top:12px;">
      <% Member::PREFERENCE_FIELDS.each do |key, cfg| %>
        <% val = booking.member.preference(key) %>
        <% next if val.blank? %>
        <span class="l-chip" style="font-size:12px;"><%= cfg[:label] %>: <strong><%= val %></strong></span>
      <% end %>
    </div>
  <% end %>

  <%# ---- Việc làm ngay ---- %>
  <div style="display:flex; gap:7px; flex-wrap:wrap; margin-top:16px;">
    <% [["confirmed", "Xác nhận"], ["checked_in", "Khách đã đến"],
        ["in_progress", "Bắt đầu làm"], ["completed", "Hoàn thành"]].each do |target, label| %>
      <% if booking.can_transition_to?(target) %>
        <%= button_to label, status_merchant_booking_path(booking, value: target, cal_from: cal_from),
              method: :patch, class: "l-btn l-btn-primary", style: "padding:9px 14px;",
              form: { style: "display:inline;",
                      data: in_calendar ? {} : { turbo_frame: "_top" } } %>
      <% end %>
    <% end %>
    <% if booking.can_transition_to?("no_show") %>
      <%= button_to "Khách không đến", status_merchant_booking_path(booking, value: "no_show", cal_from: cal_from),
            method: :patch, class: "l-btn l-btn-ghost", style: "padding:9px 14px; color:#B4402F;",
            form: { style: "display:inline;",
                    data: (in_calendar ? {} : { turbo_frame: "_top" }).merge(
                      turbo_confirm: "Đánh dấu khách không đến? Số lần bỏ hẹn của khách sẽ tăng và có thể bị chặn đặt online.") } %>
    <% end %>
    <% if module_on?("pos") && !booking.cancelled? && !booking.no_show? %>
      <% bill = booking.order %>
      <% if bill %>
        <%= link_to bill.paid? ? "Xem bill" : "Tiếp tục thu tiền", merchant_order_path(bill),
              class: "l-btn l-btn-ghost", style: "padding:9px 14px;", data: { turbo_frame: "_top" } %>
      <% else %>
        <%= button_to "💰 Thu tiền", open_for_booking_merchant_orders_path, method: :post,
              params: { booking_id: booking.id }, class: "l-btn l-btn-ghost",
              style: "padding:9px 14px;", form: { style: "display:inline;", data: { turbo_frame: "_top" } } %>
      <% end %>
    <% end %>
    <% if booking.customer_phone.present? %>
      <%= link_to "☎ #{booking.customer_phone}", "tel:#{booking.customer_phone}",
            class: "l-btn l-btn-ghost", style: "padding:9px 14px;" %>
    <% end %>
  </div>

  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-top:14px;
              padding-top:12px; border-top:1px solid var(--line); font-size:13px;">
    <%= link_to "Mở trang đầy đủ →", merchant_booking_path(booking), data: { turbo_frame: "_top" },
          style: "font-weight:600; color:var(--primary-ink); text-decoration:none;" %>
    <% if booking.member %>
      <%= link_to "Hồ sơ khách", merchant_customer_path(booking.member), data: { turbo_frame: "_top" },
            style: "color:var(--ink-2); text-decoration:none;" %>
    <% end %>
    <span style="margin-left:auto; color:var(--ink-2);">Đổi giờ, gán KTV &amp; phòng ở trang đầy đủ</span>
  </div>
<% end %>
