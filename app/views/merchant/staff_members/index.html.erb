<% content_for :title, "Nhân sự & KTV" %>

<div style="display:flex; align-items:center; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
  <%= form_with url: merchant_staff_index_path, method: :get, html: { style: "display:flex; gap:8px; flex-wrap:wrap;" } do %>
    <%= select_tag :status,
          options_for_select(StaffMember::STATUSES.map { |s| ["#{StaffMember::STATUS_LABELS[s]} (#{@counts[s].to_i})", s] }, @status),
          class: "l-field", style: "width:auto;", onchange: "this.form.requestSubmit()" %>
    <%= select_tag :role,
          options_for_select(StaffMember::ROLES.map { |r| [StaffMember::ROLE_LABELS[r], r] }, params[:role]),
          include_blank: "Mọi vai trò", class: "l-field", style: "width:auto;", onchange: "this.form.requestSubmit()" %>
  <% end %>
  <div style="margin-left:auto; display:flex; gap:8px;">
    <%= link_to "Hạng KTV", merchant_staff_levels_path, class: "l-btn l-btn-ghost" %>
    <% if current_membership&.can_manage? %>
      <%= link_to "+ Thêm nhân sự", new_merchant_staff_path, class: "l-btn l-btn-primary" %>
    <% end %>
  </div>
</div>

<div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
  <% StaffMember::ROLES.each do |r| %>
    <% n = @role_counts[r].to_i %>
    <% next if n.zero? %>
    <span class="l-chip"><%= StaffMember::ROLE_LABELS[r] %> · <strong><%= n %></strong></span>
  <% end %>
</div>

<% if @staff.empty? %>
  <div class="l-panel" style="text-align:center; padding:40px;">
    <div style="font-size:40px;">🧑‍🔧</div>
    <p style="font-weight:700; margin-top:8px;">Chưa có nhân sự nào</p>
    <p style="color:var(--ink-2); font-size:13.5px; margin:6px 0 14px;">
      KTV không cần tài khoản đăng nhập vẫn xếp ca và tính hoa hồng được.
    </p>
    <%= link_to "Thêm nhân sự đầu tiên", new_merchant_staff_path, class: "l-btn l-btn-primary" %>
  </div>
<% else %>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:12px;">
    <% @staff.each do |s| %>
      <%= link_to merchant_staff_path(s), class: "l-tile", style: "text-decoration:none; color:inherit; display:block;" do %>
        <div style="display:flex; gap:10px; align-items:flex-start;">
          <div style="width:42px; height:42px; border-radius:12px; flex:none; display:grid; place-items:center;
                      font-weight:700; color:#fff; background:<%= s.color %>;">
            <%= s.initials %>
          </div>
          <div style="flex:1; min-width:0;">
            <div style="font-weight:700; font-size:14.5px;"><%= s.display_name %></div>
            <div style="font-size:12.5px; color:var(--ink-2);">
              <%= s.role_label %><%= " · #{s.level_name}" if s.level_name %>
            </div>
          </div>
          <span class="l-pill" style="--_c:<%= s.active? ? '#3F7A57' : '#6B635A' %>;"><%= s.status_label %></span>
        </div>
        <div style="font-size:12px; color:var(--ink-2); margin-top:10px; line-height:1.6;">
          <%= s.branch&.name || "Chưa gán cơ sở" %><br>
          Hoa hồng <%= s.commission_rate %>%<%= " · phụ thu #{number_with_delimiter(s.surcharge)}đ" if s.surcharge.positive? %>
          <%= " · khách không chọn được" unless s.online_bookable %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
