<%# One "used / cap" meter. cap nil = no limit (trial, Business, or tenants,
    which no plan caps) — "/∞" read as a limit, so say it in words instead. %>
<% pct = cap.to_i.positive? ? [(used * 100.0 / cap).round, 100].min : 0 %>
<div class="u">
  <div style="font-size:12.5px; color:var(--ink-2);"><%= label %></div>
  <div class="l-num" style="font-size:19px;">
    <%= used %><% if cap %><span style="font-size:12.5px; color:var(--ink-2);">/<%= cap %></span><% end %>
  </div>
  <% if cap %>
    <div class="bar <%= "full" if used >= cap %>"><i style="width:<%= pct %>%;"></i></div>
    <% if used >= cap %>
      <div style="font-size:11.5px; color:#e5484d; margin-top:5px;">Đã đầy — nâng gói để thêm</div>
    <% end %>
  <% else %>
    <div style="font-size:11.5px; color:var(--ink-2); margin-top:5px;">Không giới hạn</div>
  <% end %>
</div>
