<% content_for :title, "Đăng ký — Aura" %>

<section class="m-formwrap"><div class="m-in">
  <div class="m-formcard">
    <div class="eyebrow">Dùng thử miễn phí <%= Workspace::TRIAL_DAYS %> ngày</div>
    <h1>Tạo tài khoản chủ hộ</h1>
    <p class="sub">Đăng ký bằng email, không cần mật khẩu — bạn đăng nhập bằng mã OTP gửi qua email.</p>

    <%# turbo: false — đăng ký xong redirect sang subdomain mới tạo. %>
    <%= form_with model: @workspace, url: merchant_signup_path, local: true, data: { turbo: false } do |f| %>
      <% if @workspace.errors.any? %>
        <div class="l-chip" style="background:#fde8e8; color:#a11; margin-bottom:14px; display:block;">
          <%= @workspace.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="m-field">
        <label class="l-label">Tên doanh nghiệp / chủ nhà *</label>
        <%= f.text_field :name, class: "l-field", placeholder: "VD: Sunrise Apartments", required: true %>
      </div>

      <div class="m-field">
        <label class="l-label">Tên miền phụ (subdomain) *</label>
        <div style="display:flex; align-items:center; gap:8px;">
          <%= f.text_field :subdomain, class: "l-field", placeholder: "sunrise", required: true, style: "flex:1;" %>
          <span style="color:var(--ink-2); font-size:14px; white-space:nowrap;">.aura.czin.net</span>
        </div>
        <div style="font-size:12px; color:var(--ink-2); margin-top:4px;">Địa chỉ riêng cho trang quản lý và app người thuê của bạn.</div>
      </div>

      <div class="m-grid2">
        <div class="m-field">
          <label class="l-label">Họ tên của bạn</label>
          <%= text_field_tag :owner_name, params[:owner_name], class: "l-field", placeholder: "Nguyễn Văn A" %>
        </div>
        <div class="m-field">
          <label class="l-label">Email *</label>
          <%= email_field_tag :email, params[:email], class: "l-field", placeholder: "you@example.com", required: true %>
        </div>
      </div>
      <div class="m-field">
        <label class="l-label">Mật khẩu * (tối thiểu 6 ký tự)</label>
        <%= password_field_tag :password, nil, class: "l-field", placeholder: "••••••••", required: true, minlength: 6 %>
        <div style="font-size:12px; color:var(--ink-2); margin-top:4px;">Sau này bạn có thể đăng nhập bằng mật khẩu hoặc mã OTP qua email.</div>
      </div>

      <%= f.submit "Tạo tài khoản & bắt đầu", class: "m-btn solid lg", style: "width:100%; justify-content:center; border:none; cursor:pointer; margin-top:8px;" %>
    <% end %>

    <p style="text-align:center; color:var(--ink-2); font-size:13px; margin-top:16px;">
      Đã có tài khoản? <a href="/merchant/login" style="color:var(--brown); font-weight:600;">Đăng nhập</a>
    </p>
  </div>
</div></section>
