<% content_for :title, "Sửa hạng thẻ" %>
<%= form_with model: @tier, url: merchant_member_tier_path(@tier), method: :patch do |f| %>
  <% if @tier.errors.any? %>
    <div class="l-panel" style="background:#fdecec; border-color:#f5c6c6; color:#a11; margin-bottom:16px;">
      <%= @tier.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div class="l-panel" style="max-width:620px;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:14px;">
      <div>
        <label class="l-label">Tên hạng</label>
        <%= f.text_field :name, class: "l-field" %>
      </div>
      <div>
        <label class="l-label">Chi tiêu từ (đ)</label>
        <%= f.number_field :min_spent, class: "l-field", step: 1_000_000 %>
      </div>
      <div>
        <label class="l-label">Số lượt từ</label>
        <%= f.number_field :min_visits, class: "l-field", min: 0 %>
      </div>
      <div>
        <label class="l-label">Giảm giá (%)</label>
        <%= f.number_field :discount_percent, class: "l-field", min: 0, max: 100 %>
      </div>
      <div>
        <label class="l-label">Hệ số điểm</label>
        <%= f.number_field :points_multiplier, class: "l-field", step: 0.1 %>
      </div>
      <div>
        <label class="l-label">Màu</label>
        <%= f.text_field :color, class: "l-field" %>
      </div>
      <div>
        <label class="l-label">Thứ tự</label>
        <%= f.number_field :position, class: "l-field" %>
      </div>
    </div>
    <div class="l-toggle-row">
      <div>
        <div style="font-weight:600; font-size:14px;">Tự động nâng hạng</div>
        <div style="font-size:12.5px; color:var(--ink-2);">Khách đạt ngưỡng là lên hạng ngay sau khi đóng bill.</div>
      </div>
      <label class="l-switch"><%= f.check_box :auto_assign %><span class="knob"></span></label>
    </div>
    <div style="display:flex; gap:10px; margin-top:16px;">
      <%= f.submit "Lưu", class: "l-btn l-btn-primary" %>
      <%= link_to "Huỷ", merchant_member_tiers_path, class: "l-btn l-btn-ghost" %>
      <%= button_to "Xoá", merchant_member_tier_path(@tier), method: :delete, class: "l-btn l-btn-ghost",
            style: "margin-left:auto; color:#B4402F;", form: { data: { turbo_confirm: "Xoá hạng này? Khách đang ở hạng sẽ về không hạng." } } %>
    </div>
  </div>
<% end %>
